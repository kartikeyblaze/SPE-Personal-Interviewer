pipeline {
    agent any

    triggers {
        githubPush()
    }

    environment {
        DOCKER_HUB_CREDS = credentials('docker-hub-creds')
        IMAGE_AUTH = "${DOCKER_HUB_CREDS_USR}/auth-service"
        IMAGE_INTERVIEW = "${DOCKER_HUB_CREDS_USR}/interview-service"
        IMAGE_FRONTEND = "${DOCKER_HUB_CREDS_USR}/frontend-service"
        SECURITY_REPORT_DIR = 'reports/security'
        SECURITY_SEVERITY = 'HIGH,CRITICAL'
        APP_BASE_URL = 'http://interview.local'
        ANSIBLE_VENV = '.ansible-venv'
    }

    stages {
        stage('Prepare Security Reports') {
            steps {
                sh 'mkdir -p "${SECURITY_REPORT_DIR}"'
            }
        }

        stage('Secret Scan') {
            steps {
                sh '''
                docker run --rm \
                    -v "$WORKSPACE:/repo" \
                    -w /repo \
                    zricethezav/gitleaks:latest detect \
                    --source=/repo \
                    --report-format=json \
                    --report-path="${SECURITY_REPORT_DIR}/gitleaks.json" \
                    --redact \
                    --exit-code=1
                '''
            }
        }

        stage('SCA Filesystem Scan') {
            steps {
                sh '''
                docker run --rm \
                    -v "$WORKSPACE:/repo" \
                    -v trivy-cache:/root/.cache/ \
                    -w /repo \
                    aquasec/trivy:latest fs \
                    --scanners vuln \
                    --severity "${SECURITY_SEVERITY}" \
                    --format json \
                    --output "${SECURITY_REPORT_DIR}/trivy-fs.json" \
                    --exit-code 1 \
                    services
                '''
            }
        }

        stage('SAST Scan') {
            steps {
                sh '''
                docker run --rm \
                    -v "$WORKSPACE:/src" \
                    -w /src \
                    semgrep/semgrep:latest semgrep scan \
                    --config p/owasp-top-ten \
                    --config p/nodejs \
                    --severity ERROR \
                    --sarif \
                    --output "${SECURITY_REPORT_DIR}/semgrep.sarif" \
                    --error \
                    services
                '''
            }
        }

        stage('IaC Scan') {
            steps {
                sh '''
                docker run --rm \
                    -v "$WORKSPACE:/repo" \
                    -v trivy-cache:/root/.cache/ \
                    -w /repo \
                    aquasec/trivy:latest config \
                    --severity "${SECURITY_SEVERITY}" \
                    --format json \
                    --output "${SECURITY_REPORT_DIR}/trivy-iac.json" \
                    --exit-code 1 \
                    .
                '''
            }
        }

        stage('Build') {
            steps {
                script {
                    sh "docker build -t ${IMAGE_AUTH}:${BUILD_NUMBER} services/auth"
                    sh "docker tag ${IMAGE_AUTH}:${BUILD_NUMBER} ${IMAGE_AUTH}:latest"
                    sh "docker build -t ${IMAGE_INTERVIEW}:${BUILD_NUMBER} services/interview"
                    sh "docker tag ${IMAGE_INTERVIEW}:${BUILD_NUMBER} ${IMAGE_INTERVIEW}:latest"
                    sh "docker build -t ${IMAGE_FRONTEND}:${BUILD_NUMBER} services/frontend"
                    sh "docker tag ${IMAGE_FRONTEND}:${BUILD_NUMBER} ${IMAGE_FRONTEND}:latest"
                }
            }
        }

        stage('Container Image Scan') {
            steps {
                sh '''
                docker run --rm \
                    -v /var/run/docker.sock:/var/run/docker.sock \
                    -v "$WORKSPACE:/repo" \
                    -v trivy-cache:/root/.cache/ \
                    -w /repo \
                    aquasec/trivy:latest image \
                    --severity "${SECURITY_SEVERITY}" \
                    --format json \
                    --output "${SECURITY_REPORT_DIR}/trivy-auth-image.json" \
                    --exit-code 1 \
                    "${IMAGE_AUTH}:${BUILD_NUMBER}"

                docker run --rm \
                    -v /var/run/docker.sock:/var/run/docker.sock \
                    -v "$WORKSPACE:/repo" \
                    -v trivy-cache:/root/.cache/ \
                    -w /repo \
                    aquasec/trivy:latest image \
                    --severity "${SECURITY_SEVERITY}" \
                    --format json \
                    --output "${SECURITY_REPORT_DIR}/trivy-interview-image.json" \
                    --exit-code 1 \
                    "${IMAGE_INTERVIEW}:${BUILD_NUMBER}"

                docker run --rm \
                    -v /var/run/docker.sock:/var/run/docker.sock \
                    -v "$WORKSPACE:/repo" \
                    -v trivy-cache:/root/.cache/ \
                    -w /repo \
                    aquasec/trivy:latest image \
                    --severity "${SECURITY_SEVERITY}" \
                    --format json \
                    --output "${SECURITY_REPORT_DIR}/trivy-frontend-image.json" \
                    --exit-code 1 \
                    "${IMAGE_FRONTEND}:${BUILD_NUMBER}"
                '''
            }
        }

        stage('Push to Docker Hub') {
            steps {
                sh 'echo "$DOCKER_HUB_CREDS_PSW" | docker login -u "$DOCKER_HUB_CREDS_USR" --password-stdin'
                sh "docker push ${IMAGE_AUTH}:${BUILD_NUMBER}"
                sh "docker push ${IMAGE_AUTH}:latest"
                sh "docker push ${IMAGE_INTERVIEW}:${BUILD_NUMBER}"
                sh "docker push ${IMAGE_INTERVIEW}:latest"
                sh "docker push ${IMAGE_FRONTEND}:${BUILD_NUMBER}"
                sh "docker push ${IMAGE_FRONTEND}:latest"
            }
        }

        stage('Deploy to Kubernetes with Ansible') {
            steps {
                sh '''
                python3 -m venv "${ANSIBLE_VENV}"
                . "${ANSIBLE_VENV}/bin/activate"
                pip install --upgrade pip
                pip install --no-cache-dir -r ansible/requirements.txt
                '''
                withCredentials([
                    string(credentialsId: 'ansible-vault-password', variable: 'VAULT_PASSWORD'),
                    file(credentialsId: 'kubeconfig', variable: 'KUBECONFIG_FILE')
                ]) {
                    sh '''
                    tmp_vault_password="$(mktemp)"
                    trap 'rm -f "$tmp_vault_password"' EXIT
                    printf '%s' "$VAULT_PASSWORD" > "$tmp_vault_password"
                    export KUBECONFIG="$KUBECONFIG_FILE"
                    export ANSIBLE_PYTHON_INTERPRETER="$WORKSPACE/${ANSIBLE_VENV}/bin/python"
                    ansible-playbook ansible/playbooks/deploy.yml \
                        --vault-password-file "$tmp_vault_password" \
                        -e ansible_python_interpreter="$ANSIBLE_PYTHON_INTERPRETER" \
                        -e image_tag=${BUILD_NUMBER} \
                        -e docker_hub_user=${DOCKER_HUB_CREDS_USR}
                    '''
                }
            }
        }

        stage('DAST Baseline Scan') {
            steps {
                sh '''
                curl -fsS --retry 12 --retry-all-errors --retry-delay 5 "${APP_BASE_URL}/api/interview/health"

                docker run --rm \
                    --network host \
                    -v "$WORKSPACE/${SECURITY_REPORT_DIR}:/zap/wrk" \
                    zaproxy/zap-stable:latest zap-baseline.py \
                    -t "${APP_BASE_URL}" \
                    -r zap-baseline.html \
                    -J zap-baseline.json \
                    -w zap-baseline.md \
                    -I
                '''
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'reports/security/**/*', allowEmptyArchive: true
        }
    }
}
